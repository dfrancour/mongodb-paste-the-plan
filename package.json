{
  "name": "mongodb-paste-the-plan",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./paste-the-plan": {
      "types": "./src/components/paste-the-plan/PasteThePlanContainer.d.ts",
      "default": "./src/components/paste-the-plan/PasteThePlanContainer.tsx"
    },
    "./stage-glossary": {
      "types": "./src/components/stage-glossary/GlossaryContainer.d.ts",
      "default": "./src/components/stage-glossary/GlossaryContainer.tsx"
    }
  },
  "imports": {
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*",
    "#types/*": "./src/types/*",
    "#data/*": "./src/data/*",
    "#hooks/*": "./src/hooks/*",
    "#test-utils/*": "./src/test-utils/*"
  },
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit && pnpm run test:run",
    "pre-push": "pnpm run format:check && pnpm run check && pnpm run build",
    "dev": "next dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.563.0",
    "lz-string": "^1.5.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.26.0"
}
